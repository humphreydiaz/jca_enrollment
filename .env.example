APP_NAME="JCA Enrollment and Student Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://jca-enrollment.test
FORCE_HTTPS=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# MySQL is required. Use a dedicated least-privilege user outside local development.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jca_enrollment
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# This project intentionally uses database-backed infrastructure, not Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180
DB_QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_ALERT_PENDING_JOBS=100
QUEUE_ALERT_FAILED_JOBS=0
QUEUE_PRUNE_FAILED_HOURS=720
QUEUE_PRUNE_BATCH_HOURS=168

DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
CACHE_PREFIX=jca_enrollment_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# The private document disk is available. Upload and retention rules are wired in the Documents phase.
DOCUMENTS_DISK=documents
DOCUMENT_MAX_UPLOAD_KB=10240
DOCUMENT_RETENTION_AUTOMATION=false
DOCUMENTS_THROW=false

# Report exports are private, short-lived files. Never point this at the public disk.
REPORTS_DISK=reports
REPORT_EXPORT_TTL_HOURS=24
REPORT_EXPORT_ROW_LIMIT=10000
REPORT_PRINT_ROW_LIMIT=1000
REPORTS_THROW=false

# Launch attestations stay false until the named JCA owner signs the matching production artifact.
JCA_RETENTION_POLICY_APPROVED=false
JCA_FINANCE_POLICY_APPROVED=false
JCA_ACADEMIC_CATALOG_APPROVED=false
JCA_SUPPORT_WORKFLOW_APPROVED=false
JCA_SMS_POLICY_APPROVED=false
JCA_REPORTS_APPROVED=false
JCA_HOSTING_RECOVERY_APPROVED=false
JCA_ACCESS_UAT_APPROVED=false
BACKUP_ENCRYPTION_CONFIGURED=false
BACKUP_OFFSITE_CONFIGURED=false
BACKUP_MONITORING_CONFIGURED=false
# D-060 built-in backups: made when an Admin clicks "Back up now" (or php artisan jca:backup), never on a schedule.
# BACKUP_PATH defaults to storage/app/backups. Leave BACKUP_ENCRYPTION_KEY empty to derive the key from APP_KEY,
# or set a base64 32-byte key; either way keep a copy of the key somewhere safe and separate from the backups.
BACKUP_PATH=
BACKUP_KEEP=14
BACKUP_REMIND_AFTER_DAYS=7
BACKUP_ENCRYPTION_KEY=

# Testing only: permits separate Student and Guardian logins to reuse one mobile number.
ALLOW_SHARED_CONTACT_ACCOUNTS=false

# SMS remains disabled/log-only until JCA approves sender, consent, templates, and live credentials.
# These variables are wired in the Communications phase.
SMS_ENABLED=false
SMS_DRIVER=disabled
# priority (2 credits per 160-character part) or standard (1 credit)
SMS_MESSAGE_ROUTE=priority
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_BASE_URL=https://api.semaphore.co

VITE_APP_NAME="${APP_NAME}"
