APP_NAME="JCA Enrollment and Student Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://enrollment.example.edu.ph
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=notice
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jca_enrollment_production
DB_USERNAME=jca_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=jca_enrollment_production_
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180
DB_QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_ALERT_PENDING_JOBS=100
QUEUE_ALERT_FAILED_JOBS=0
QUEUE_PRUNE_FAILED_HOURS=720
QUEUE_PRUNE_BATCH_HOURS=168

FILESYSTEM_DISK=local
DOCUMENTS_DISK=documents
DOCUMENT_MAX_UPLOAD_KB=10240
DOCUMENT_RETENTION_AUTOMATION=false
DOCUMENTS_THROW=true
REPORTS_DISK=reports
REPORT_EXPORT_TTL_HOURS=24
REPORT_EXPORT_ROW_LIMIT=10000
REPORT_PRINT_ROW_LIMIT=1000
REPORTS_THROW=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Live SMS (D-070): set SMS_ENABLED=true and SMS_DRIVER=semaphore, and paste the Semaphore key on the server only
# (never in source control). Leave SEMAPHORE_SENDER_NAME empty until Semaphore approves the school's sender name.
SMS_ENABLED=false
SMS_DRIVER=disabled
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_BASE_URL=https://api.semaphore.co

# Set an attestation to true only after the named signed approval is stored in the launch record.
JCA_RETENTION_POLICY_APPROVED=false
JCA_FINANCE_POLICY_APPROVED=false
JCA_ACADEMIC_CATALOG_APPROVED=false
JCA_SUPPORT_WORKFLOW_APPROVED=false
JCA_SMS_POLICY_APPROVED=false
JCA_REPORTS_APPROVED=false
JCA_HOSTING_RECOVERY_APPROVED=false
JCA_ACCESS_UAT_APPROVED=false
BACKUP_ENCRYPTION_CONFIGURED=false
BACKUP_OFFSITE_CONFIGURED=false
BACKUP_MONITORING_CONFIGURED=false
# D-060 built-in backups: made when an Admin clicks "Back up now" (or php artisan jca:backup), never on a schedule.
# BACKUP_PATH defaults to storage/app/backups. Leave BACKUP_ENCRYPTION_KEY empty to derive the key from APP_KEY,
# or set a base64 32-byte key; either way keep a copy of the key somewhere safe and separate from the backups.
BACKUP_PATH=
BACKUP_KEEP=14
BACKUP_REMIND_AFTER_DAYS=7
BACKUP_ENCRYPTION_KEY=

VITE_APP_NAME="${APP_NAME}"
