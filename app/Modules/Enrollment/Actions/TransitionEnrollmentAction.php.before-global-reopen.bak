<?php

namespace App\Modules\Enrollment\Actions;

use App\Models\User;
use App\Modules\Enrollment\Events\EnrollmentApproved;
use App\Modules\Enrollment\Events\EnrollmentStatusChanged;
use App\Modules\Enrollment\Models\Enrollment;
use App\Modules\Enrollment\Models\EnrollmentStatusHistory;
use App\Modules\Enrollment\Support\EnrollmentApplicationCompleteness;
use App\Modules\People\Actions\IssueStudentNumberAction;
use App\Modules\Requirements\Actions\AssertEnrollmentRequirementsSatisfiedAction;
use App\Modules\Requirements\Actions\GenerateEnrollmentChecklistAction;
use App\Modules\Shared\Audit\AuditRecorder;
use App\Modules\StudentSupport\Models\SupportCase;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;

class TransitionEnrollmentAction
{
    /** @var array<string, list<string>> */
    private const ALLOWED_TRANSITIONS = [
        'draft' => ['submitted', 'cancelled'],
        'submitted' => [
            'under_review',
            'incomplete',
            'assessment_required',
            'waitlisted',
            'rejected',
            'cancelled',
        ],
        'under_review' => [
            'incomplete',
            'assessment_required',
            'approved',
            'waitlisted',
            'rejected',
            'cancelled',
        ],
        'incomplete' => ['submitted', 'rejected', 'cancelled'],
        'assessment_required' => [
            'assessment_pending',
            'rejected',
            'cancelled',
        ],
        'assessment_pending' => [
            'under_review',
            'rejected',
            'cancelled',
        ],
        'waitlisted' => ['under_review', 'rejected', 'cancelled'],
        'approved' => ['withdrawn'],
    ];

    public function __construct(
        private AuditRecorder $audit,
        private GenerateEnrollmentChecklistAction $checklist,
        private AssertEnrollmentRequirementsSatisfiedAction $requirementsSatisfied,
        private IssueStudentNumberAction $issueStudentNumber,
        private EnrollmentApplicationCompleteness $completeness
    ) {}

    /** @return list<string> */
    public static function allowedTransitionsFrom(string $status): array
    {
        return self::ALLOWED_TRANSITIONS[$status] ?? [];
    }

    public function execute(
        Enrollment $enrollment,
        string $to,
        ?User $actor,
        string $reason = ''
    ): Enrollment {
        return DB::transaction(function () use (
            $enrollment,
            $to,
            $actor,
            $reason
        ) {
            $record = Enrollment::query()
                ->lockForUpdate()
                ->with('requirements')
                ->findOrFail($enrollment->id);

            $from = $record->status;

            if (! in_array(
                $to,
                self::allowedTransitionsFrom($from),
                true
            )) {
                throw ValidationException::withMessages([
                    'status' => 'This enrollment transition is not allowed.',
                ]);
            }

            // Late enrollment security validation
            if (in_array($to, ['submitted', 'approved'], true)) {
                $record->loadMissing('academicYear');

                $schoolYear = $record->academicYear;
                $today = now('Asia/Manila')->toDateString();

                if ($to === 'submitted') {
                    if (
                        ! $schoolYear
                        || $schoolYear->status !== 'open'
                    ) {
                        throw ValidationException::withMessages([
                            'application' =>
                                'Enrollment is closed. Please contact the Registrar.',
                        ]);
                    }

                    if (
                        filled($schoolYear->enrollment_opens_on)
                        && $today < Carbon::parse(
                            $schoolYear->enrollment_opens_on
                        )->toDateString()
                    ) {
                        throw ValidationException::withMessages([
                            'application' =>
                                'Enrollment is not yet open. Please contact the Registrar.',
                        ]);
                    }
                }

                $pastDeadline = $schoolYear
                    && filled($schoolYear->enrollment_closes_on)
                    && $today > Carbon::parse(
                        $schoolYear->enrollment_closes_on
                    )->toDateString();

                $requiresLateApproval =
                    (bool) $record->is_late_enrollment
                    || $pastDeadline;

                if (
                    $requiresLateApproval
                    && (
                        ! $record->is_late_enrollment
                        || $record->late_enrollment_status !== 'approved'
                    )
                ) {
                    throw ValidationException::withMessages([
                        'application' =>
                            $record->late_enrollment_status === 'rejected'
                                ? 'Late enrollment request was rejected. Contact the Registrar.'
                                : 'Late enrollment requires Admin or Registrar approval before proceeding.',
                    ]);
                }
            }



            // Identity verification
            if (
                $to === 'submitted'
                && $record->contact_verified_at === null
                && $record->walk_in_verified_at === null
                && $record->previous_enrollment_id === null
            ) {
                throw ValidationException::withMessages([
                    'status' =>
                        'Registrar walk-in verification is required before submission.',
                ]);
            }

            // Application completeness
            if (
                $from === 'draft'
                && $to === 'submitted'
                && $this->completeness->appliesTo($record)
            ) {
                $missing = $this->completeness->missing($record);

                if ($missing !== []) {
                    throw ValidationException::withMessages([
                        'application' =>
                            'Complete and save every required application field before submission. Still missing: '
                            .implode(', ', $missing).'.',
                    ]);
                }
            }

            // Duplicate record validation
            if (
                $to === 'under_review'
                && $record->duplicate_review_status === 'pending'
            ) {
                throw ValidationException::withMessages([
                    'status' =>
                        'Potential duplicate identity must be reviewed first.',
                ]);
            }

            // Submit application
            if ($to === 'submitted') {
                if (
                    $this->checklist->execute($record) === 0
                    && ! $record->requirements()->exists()
                ) {
                    throw ValidationException::withMessages([
                        'application' =>
                            'Enrollment requirements are not configured for this school year and applicant category. Please contact the JCA Registrar before submitting.',
                    ]);
                }

                $record->submitted_at = now();

                $record->loadMissing('student', 'academicYear');

                if (
                    $record->student !== null
                    && $record->academicYear !== null
                ) {
                    $this->issueStudentNumber->execute(
                        $record->student,
                        $record->academicYear
                    );
                }
            }

            // Approve application
            if ($to === 'approved') {
                $record->load('requirements');

                if ($record->duplicate_review_status === 'pending') {
                    throw ValidationException::withMessages([
                        'status' =>
                            'Potential duplicate identity must be reviewed first.',
                    ]);
                }

                $this->requirementsSatisfied->execute($record);

                if (
                    $record->student_category === 'support_review'
                    && ! SupportCase::query()
                        ->where('enrollment_id', $record->id)
                        ->where('final_outcome', 'approved')
                        ->exists()
                ) {
                    throw ValidationException::withMessages([
                        'status' =>
                            'An approved support review is required.',
                    ]);
                }

                $record->approved_at = now();
            }

            // Update enrollment status
            $record->status = $to;

            if (in_array(
                $to,
                ['rejected', 'withdrawn', 'cancelled'],
                true
            )) {
                if ($to === 'rejected') {
                    $record->rejected_at = now();
                }

                if ($to === 'withdrawn') {
                    $record->withdrawn_at = now();
                }

                $record->active_enrollment_key = null;
                $record->active_student_application_key = null;
            }

            $record->decided_by = $actor?->id;
            $record->decision_reason = $reason ?: null;
            $record->lock_version++;
            $record->save();

            // Status history
            EnrollmentStatusHistory::query()->create([
                'enrollment_id' => $record->id,
                'from_status' => $from,
                'to_status' => $to,
                'reason' => $reason ?: null,
                'changed_by' => $actor?->id,
                'changed_at' => now(),
            ]);

            // Enrollment decisions
            if (in_array(
                $to,
                ['approved', 'rejected', 'waitlisted'],
                true
            )) {
                DB::table('enrollment_decisions')->insert([
                    'enrollment_id' => $record->id,
                    'decision_type' => 'academic_admission',
                    'outcome' => $to,
                    'reason' => $reason ?: null,
                    'decided_by' => $actor?->id,
                    'decided_at' => now(),
                    'created_at' => now(),
                    'updated_at' => now(),
                ]);
            }

            // Audit trail
            $this->audit->record(
                $actor,
                'enrollment.status.changed',
                $record,
                [
                    'from' => $from,
                    'to' => $to,
                ]
            );

            event(new EnrollmentStatusChanged(
                $record,
                $from,
                $to,
                $actor
            ));

            if ($to === 'approved') {
                event(new EnrollmentApproved($record, $actor));
            }

            return $record;
        });
    }
}